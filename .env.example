# =============================================================================
# Plantilla de variables de entorno (.env.example)
#
# NO uses este archivo tal cual. Genera el archivo real `.env` en la raíz del
# repo con uno de estos scripts, que sustituyen cada CHANGE_ME_* por un valor
# aleatorio criptográficamente seguro:
#   Windows (PowerShell):      scripts/init-env.ps1
#   Git Bash / Linux / macOS:  scripts/init-env.sh
#
# El archivo `.env` contiene secretos reales: NUNCA se versiona (está en
# .gitignore) ni se comparte por chat. No pongas valores reales aquí.
# =============================================================================

# --- JWT (auth firma; gateway y servicios validan) --------------------------
# Secreto HS256. Mínimo 32 caracteres. Generado por el script (>= 48).
JWT_SECRET=CHANGE_ME_JWT_SECRET
# Emisor del token. Debe coincidir en todos los servicios.
JWT_ISSUER=micro-inventory
# Duración del token de acceso, en minutos.
JWT_EXPIRATION_MINUTES=60

# --- Llamadas internas servicio→servicio (/internal/**) ----------------------
# Clave compartida enviada en la cabecera X-Internal-Key. Generada por el script.
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY

# --- Contraseñas de las bases de datos PostgreSQL (una por servicio) ---------
# Generadas por el script (>= 32 caracteres).
AUTH_DB_PASSWORD=CHANGE_ME_AUTH_DB_PASSWORD
INVENTORY_DB_PASSWORD=CHANGE_ME_INVENTORY_DB_PASSWORD
ORDER_DB_PASSWORD=CHANGE_ME_ORDER_DB_PASSWORD
NOTIFICATION_DB_PASSWORD=CHANGE_ME_NOTIFICATION_DB_PASSWORD

# --- Notificaciones (WebSocket) ----------------------------------------------
# Orígenes permitidos para el handshake WebSocket, separados por comas.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Registro de usuarios -----------------------------------------------------
# true = cualquiera puede registrarse; false = registro cerrado.
REGISTRATION_ENABLED=true

# --- Puertos publicados en tu máquina (solo en 127.0.0.1) ----------------------
# Cámbialos si 3000 u 8080 ya están ocupados (p. ej. por un servidor de desarrollo).
# Si cambias FRONTEND_PORT, añade también ese origen a ALLOWED_ORIGINS
# (p. ej. ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001).
FRONTEND_PORT=3000
GATEWAY_PORT=8080
